  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@capacitor/ios": "^7.0.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
